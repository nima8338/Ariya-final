{% doc %}
  @prompt
    create video carousels where on the mobile version, it's one at a time, and you could only see that single video at a time. And then you can press right and left to go to the next videos. and each video should have a box around it, and under the video in the box should have the benefit with a five star rating, the name of the person in the video, and a quote from them. And each video give me the option to insert a cover image., make the video box bigger so the full video is visible, make the cover image cover the entire video box, for all the videos give the option to pause the video and fast forward it, for the benefits under each video add a text bubble to all the benefits and make the texts white with the bubble our purple color, add a header that says line one. "Real People." second like "Real Results.", add a subtex that says we'll let our community do the talking.", for the desktop give me the option to click to the last 2 videos then be able to go back, unitalicize the qoutes, give me the option to change the background color of the entire thing not the boxes, make the boxes smaller on mobile version only
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.section_background }};
  }

  .ai-video-carousel-inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-video-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-video-header-line1-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_line1_size }}px;
    color: {{ block.settings.header_line1_color }};
    font-weight: {{ block.settings.header_line1_weight }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-video-header-line2-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_line2_size }}px;
    color: {{ block.settings.header_line2_color }};
    font-weight: {{ block.settings.header_line2_weight }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-video-header-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    font-weight: {{ block.settings.subtext_weight }};
    margin: {{ block.settings.subtext_spacing }}px 0 0 0;
    line-height: 1.4;
  }

  .ai-video-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
    gap: {{ block.settings.gap_desktop }}px;
  }

  .ai-video-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.slides_per_view_desktop | minus: 1 }} * {{ block.settings.gap_desktop }}px)) / {{ block.settings.slides_per_view_desktop }});
    min-width: 0;
  }

  .ai-video-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 177.78%;
    background-color: #000000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-video-cover-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    z-index: 2;
  }

  .ai-video-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: {{ block.settings.play_button_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: transform 0.3s ease;
  }

  .ai-video-play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-video-play-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: {{ block.settings.play_button_icon_color }};
    margin-left: 3px;
  }

  .ai-video-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    padding: 15px 10px 10px;
    display: none;
    z-index: 4;
  }

  .ai-video-controls-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-video-controls-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-video-control-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-control-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.controls_icon_color }};
  }

  .ai-video-progress-container-{{ ai_gen_id }} {
    flex: 1;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    cursor: pointer;
    position: relative;
  }

  .ai-video-progress-bar-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.controls_progress_color }};
    border-radius: 2px;
    width: 0%;
    transition: width 0.1s linear;
  }

  .ai-video-time-{{ ai_gen_id }} {
    color: {{ block.settings.controls_icon_color }};
    font-size: 12px;
    min-width: 80px;
    text-align: right;
  }

  .ai-video-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-video-benefit-{{ ai_gen_id }} {
    font-size: {{ block.settings.benefit_font_size }}px;
    color: {{ block.settings.benefit_text_color }};
    font-weight: 600;
    line-height: 1.4;
    background-color: {{ block.settings.benefit_bubble_color }};
    padding: {{ block.settings.benefit_bubble_padding }}px;
    border-radius: {{ block.settings.benefit_bubble_radius }}px;
    display: inline-block;
    align-self: flex-start;
  }

  .ai-video-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-video-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-video-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_font_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-video-quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_font_size }}px;
    color: {{ block.settings.quote_color }};
    font-style: normal;
    line-height: 1.5;
  }

  .ai-video-nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.nav_button_background }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background-color 0.3s ease;
  }

  .ai-video-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
  }

  .ai-video-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_button_icon_color }};
  }

  .ai-video-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-nav-prev-{{ ai_gen_id }} {
    left: -20px;
  }

  .ai-video-nav-next-{{ ai_gen_id }} {
    right: -20px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel-inner-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
      padding: 0 {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-video-carousel-track-{{ ai_gen_id }} {
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-video-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-video-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_mobile }}px;
    }

    .ai-video-wrapper-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.mobile_video_aspect_ratio }}%;
    }

    .ai-video-nav-prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-video-nav-next-{{ ai_gen_id }} {
      right: 10px;
    }

    .ai-video-play-button-{{ ai_gen_id }} {
      width: 50px;
      height: 50px;
    }

    .ai-video-play-button-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }

    .ai-video-control-button-{{ ai_gen_id }} svg {
      width: 18px;
      height: 18px;
    }

    .ai-video-time-{{ ai_gen_id }} {
      font-size: 11px;
      min-width: 70px;
    }

    .ai-video-header-line1-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_line1_size | times: 0.8 }}px;
    }

    .ai-video-header-line2-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_line2_size | times: 0.8 }}px;
    }

    .ai-video-header-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-video-benefit-{{ ai_gen_id }} {
      font-size: {{ block.settings.benefit_font_size | times: 0.9 }}px;
    }

    .ai-video-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.name_font_size | times: 0.9 }}px;
    }

    .ai-video-quote-{{ ai_gen_id }} {
      font-size: {{ block.settings.quote_font_size | times: 0.9 }}px;
    }

    .ai-video-star-{{ ai_gen_id }} {
      width: {{ block.settings.star_size | times: 0.9 }}px;
      height: {{ block.settings.star_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }} class="ai-video-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-carousel-inner-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-video-header-{{ ai_gen_id }}">
        {% if block.settings.header_line1 != blank %}
          <h2 class="ai-video-header-line1-{{ ai_gen_id }}">{{ block.settings.header_line1 }}</h2>
        {% endif %}
        {% if block.settings.header_line2 != blank %}
          <h2 class="ai-video-header-line2-{{ ai_gen_id }}">{{ block.settings.header_line2 }}</h2>
        {% endif %}
        {% if block.settings.subtext != blank %}
          <p class="ai-video-header-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-carousel-container-{{ ai_gen_id }}">
      <div class="ai-video-carousel-track-{{ ai_gen_id }}" data-track>
        {% for i in (1..5) %}
          {% liquid
            assign video_key = 'video_' | append: i
            assign cover_key = 'cover_image_' | append: i
            assign benefit_key = 'benefit_' | append: i
            assign name_key = 'name_' | append: i
            assign quote_key = 'quote_' | append: i

            assign video = block.settings[video_key]
            assign cover_image = block.settings[cover_key]
            assign benefit = block.settings[benefit_key]
            assign name = block.settings[name_key]
            assign quote = block.settings[quote_key]
          %}

          <div class="ai-video-carousel-slide-{{ ai_gen_id }}">
            <div class="ai-video-card-{{ ai_gen_id }}">
              <div class="ai-video-wrapper-{{ ai_gen_id }}">
                {% if video %}
                  <video
                    data-video-index="{{ i }}"
                    preload="metadata"
                    playsinline
                  >
                    {% for source in video.sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>

                  {% if cover_image %}
                    <img
                      src="{{ cover_image | image_url: width: 800 }}"
                      alt="{{ cover_image.alt | escape }}"
                      class="ai-video-cover-{{ ai_gen_id }}"
                      data-cover-index="{{ i }}"
                      loading="lazy"
                    >
                    <div class="ai-video-play-button-{{ ai_gen_id }}" data-play-index="{{ i }}">
                      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                  {% endif %}

                  <div class="ai-video-controls-{{ ai_gen_id }}" data-controls-index="{{ i }}">
                    <div class="ai-video-controls-row-{{ ai_gen_id }}">
                      <button class="ai-video-control-button-{{ ai_gen_id }}" data-play-pause-index="{{ i }}" aria-label="Play/Pause">
                        <svg data-play-icon viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                        <svg data-pause-icon style="display: none;" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                        </svg>
                      </button>

                      <div class="ai-video-progress-container-{{ ai_gen_id }}" data-progress-container-index="{{ i }}">
                        <div class="ai-video-progress-bar-{{ ai_gen_id }}" data-progress-bar-index="{{ i }}"></div>
                      </div>

                      <div class="ai-video-time-{{ ai_gen_id }}" data-time-index="{{ i }}">0:00 / 0:00</div>
                    </div>
                  </div>
                {% endif %}
              </div>

              <div class="ai-video-content-{{ ai_gen_id }}">
                {% if benefit != blank %}
                  <div class="ai-video-benefit-{{ ai_gen_id }}">{{ benefit }}</div>
                {% endif %}

                <div class="ai-video-rating-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    <svg class="ai-video-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endfor %}
                </div>

                {% if name != blank %}
                  <div class="ai-video-name-{{ ai_gen_id }}">{{ name }}</div>
                {% endif %}

                {% if quote != blank %}
                  <div class="ai-video-quote-{{ ai_gen_id }}">"{{ quote }}"</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <button class="ai-video-nav-button-{{ ai_gen_id }} ai-video-nav-prev-{{ ai_gen_id }}" data-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <button class="ai-video-nav-button-{{ ai_gen_id }} ai-video-nav-next-{{ ai_gen_id }}" data-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.isMobile = window.innerWidth < 750;
        this.slidesPerView = this.isMobile ? 1 : {{ block.settings.slides_per_view_desktop }};
        this.totalSlides = 5;
        this.videoStates = {};
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.videos = this.querySelectorAll('video');
        this.covers = this.querySelectorAll('[data-cover-index]');
        this.playButtons = this.querySelectorAll('[data-play-index]');

        this.setupEventListeners();
        this.updateButtons();
        this.handleResize();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        this.playButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            const index = button.getAttribute('data-play-index');
            this.playVideo(index);
          });
        });

        this.covers.forEach((cover) => {
          cover.addEventListener('click', (e) => {
            const index = cover.getAttribute('data-cover-index');
            this.playVideo(index);
          });
        });

        this.videos.forEach((video) => {
          const index = video.getAttribute('data-video-index');

          video.addEventListener('ended', () => {
            this.resetVideo(index);
          });

          video.addEventListener('timeupdate', () => {
            this.updateProgress(index);
          });

          video.addEventListener('loadedmetadata', () => {
            this.updateTimeDisplay(index);
          });
        });

        const playPauseButtons = this.querySelectorAll('[data-play-pause-index]');
        playPauseButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const index = button.getAttribute('data-play-pause-index');
            this.togglePlayPause(index);
          });
        });

        const progressContainers = this.querySelectorAll('[data-progress-container-index]');
        progressContainers.forEach((container) => {
          container.addEventListener('click', (e) => {
            const index = container.getAttribute('data-progress-container-index');
            this.seekVideo(index, e);
          });
        });

        window.addEventListener('resize', () => this.handleResize());
      }

      handleResize() {
        const wasMobile = this.isMobile;
        this.isMobile = window.innerWidth < 750;
        this.slidesPerView = this.isMobile ? 1 : {{ block.settings.slides_per_view_desktop }};

        if (wasMobile !== this.isMobile) {
          this.currentIndex = 0;
          this.updateCarousel();
        }
      }

      playVideo(index) {
        const video = this.querySelector(`[data-video-index="${index}"]`);
        const cover = this.querySelector(`[data-cover-index="${index}"]`);
        const playButton = this.querySelector(`[data-play-index="${index}"]`);
        const controls = this.querySelector(`[data-controls-index="${index}"]`);

        if (video && cover && playButton && controls) {
          cover.style.display = 'none';
          playButton.style.display = 'none';
          controls.classList.add('active');
          video.play();
          this.updatePlayPauseIcon(index, true);
        }
      }

      resetVideo(index) {
        const video = this.querySelector(`[data-video-index="${index}"]`);
        const cover = this.querySelector(`[data-cover-index="${index}"]`);
        const playButton = this.querySelector(`[data-play-index="${index}"]`);
        const controls = this.querySelector(`[data-controls-index="${index}"]`);

        if (video && cover && playButton && controls) {
          video.pause();
          video.currentTime = 0;
          cover.style.display = 'block';
          playButton.style.display = 'flex';
          controls.classList.remove('active');
          this.updatePlayPauseIcon(index, false);
        }
      }

      togglePlayPause(index) {
        const video = this.querySelector(`[data-video-index="${index}"]`);
        if (video) {
          if (video.paused) {
            video.play();
            this.updatePlayPauseIcon(index, true);
          } else {
            video.pause();
            this.updatePlayPauseIcon(index, false);
          }
        }
      }

      updatePlayPauseIcon(index, isPlaying) {
        const button = this.querySelector(`[data-play-pause-index="${index}"]`);
        if (button) {
          const playIcon = button.querySelector('[data-play-icon]');
          const pauseIcon = button.querySelector('[data-pause-icon]');
          if (isPlaying) {
            playIcon.style.display = 'none';
            pauseIcon.style.display = 'block';
          } else {
            playIcon.style.display = 'block';
            pauseIcon.style.display = 'none';
          }
        }
      }

      updateProgress(index) {
        const video = this.querySelector(`[data-video-index="${index}"]`);
        const progressBar = this.querySelector(`[data-progress-bar-index="${index}"]`);
        
        if (video && progressBar) {
          const progress = (video.currentTime / video.duration) * 100;
          progressBar.style.width = progress + '%';
          this.updateTimeDisplay(index);
        }
      }

      updateTimeDisplay(index) {
        const video = this.querySelector(`[data-video-index="${index}"]`);
        const timeDisplay = this.querySelector(`[data-time-index="${index}"]`);
        
        if (video && timeDisplay) {
          const current = this.formatTime(video.currentTime);
          const duration = this.formatTime(video.duration);
          timeDisplay.textContent = `${current} / ${duration}`;
        }
      }

      formatTime(seconds) {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
      }

      seekVideo(index, event) {
        const video = this.querySelector(`[data-video-index="${index}"]`);
        const container = this.querySelector(`[data-progress-container-index="${index}"]`);
        
        if (video && container) {
          const rect = container.getBoundingClientRect();
          const pos = (event.clientX - rect.left) / rect.width;
          video.currentTime = pos * video.duration;
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.isMobile) {
          const maxIndex = this.totalSlides - 1;
          if (this.currentIndex < maxIndex) {
            this.currentIndex++;
            this.updateCarousel();
          }
        } else {
          const maxIndex = this.totalSlides - 1;
          if (this.currentIndex < maxIndex) {
            this.currentIndex++;
            this.updateCarousel();
          }
        }
      }

      updateCarousel() {
        const gap = this.isMobile ? {{ block.settings.gap_mobile }} : {{ block.settings.gap_desktop }};
        const slideWidth = this.track.querySelector('.ai-video-carousel-slide-{{ ai_gen_id }}').offsetWidth;
        const offset = -(this.currentIndex * (slideWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
        this.updateButtons();
      }

      updateButtons() {
        if (this.isMobile) {
          const maxIndex = this.totalSlides - 1;
          this.prevButton.disabled = this.currentIndex === 0;
          this.nextButton.disabled = this.currentIndex >= maxIndex;
        } else {
          const maxIndex = this.totalSlides - 1;
          this.prevButton.disabled = this.currentIndex === 0;
          this.nextButton.disabled = this.currentIndex >= maxIndex;
        }
      }
    }

