{% doc %}
  @prompt
    Create a brand-new testimonial carousel section from scratch for the Ariya Supplements website.
    
    This is a mobile-first testimonial section for Calm Nights.
    
    Goal
    
    Build a testimonial carousel that feels clean, premium, easy to browse, and manually controlled by the user.
    
    The carousel should not autoplay and should not move on its own.
    
    Section structure
    
    Create a section with:
    
    Headline
    Short supporting subtext
    A centered testimonial carousel
    Left/right navigation controls
    Pagination dots
    Content at the top
    
    Use this heading:
    
    Real People. Real Results.
    
    Use this subtext:
    
    Hear directly from people who have made Calm Nights part of their nightly routine.
    
    Carousel behavior
    
    Build the carousel from scratch with the following behavior:
    
    Users should be able to swipe left and right on mobile
    Users should also be able to click left and right arrows
    The carousel should move one card at a time
    No autoplay
    No automatic scrolling
    No infinite fast motion
    The active slide should feel intentional and easy to focus on
    Mobile layout
    
    On mobile:
    
    Show one main testimonial card centered
    Show a small partial preview/sliver of the previous and next card at the edges so it feels swipeable
    Keep spacing airy and premium
    Make the section feel easy to scan, not cramped
    Put the left arrow, pagination dots, and right arrow underneath the card
    The active dot should use Ariya purple (#7D45C6)
    
    Layout under the card should look like:
    
    ← ● ○ ○ ○ →
    
    Testimonial card design
    
    Each testimonial card should include:
    
    A portrait-style image or video thumbnail at the top
    A purple rounded benefit pill/tag under the image
    Examples:
    WAKE UP REFRESHED
    FALL ASLEEP FASTER
    SLEEP THROUGH THE NIGHT
    NO GROGGY MORNING
    A 5-star rating
    The customer’s name
    A short testimonial quote
    Card styling
    
    Style the cards so they feel premium and clean:
    
    White card background
    Rounded corners
    Soft subtle shadow
    Ariya color palette
    Purple accent color: #7D45C6
    Elegant, clean typography
    Clear visual hierarchy
    Good spacing between image, benefit tag, stars, name, and quote
    
    The benefit pill should feel like a branded highlight, not an afterthought.
    
    Brand direction
    
    Use Ariya’s visual feel:
    
    Clean
    Premium
    Soft
    Modern
    Wellness/supplement brand aesthetic
    White or very light background
    Purple accents
    Minimal clutter
    Desktop behavior
    
    On desktop:
    
    Keep it as a manual carousel
    Still do not autoplay
    Keep one featured card as the main focus
    It is okay if neighboring cards are partially visible
    Arrows and dots should still be present
    The section should remain clean and premium, not overcrowded
    Important requirements
    Build this as a new section from scratch
    Do not make it auto-rotating
    Do not make it move on its own
    Do not make the layout feel cramped
    Do not remove the benefit pill, stars, name, or quote
    The card content should feel readable and conversion-friendly
    Example testimonial content structure
    
    Use testimonial entries in this format:
    
    Benefit tag
    Customer name
    Quote
    
    Example format:
    
    WAKE UP REFRESHED
    McKaya Bright
    “I’ve been falling asleep easier and waking up refreshed instead of groggy.”, make the heading first line "real people" second line "real results", bold the header so its thicker
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_mobile }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-testimonial-carousel-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }
  }

  .ai-testimonial-carousel__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonial-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonial-carousel__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px 0;
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }

  @media screen and (min-width: 750px) {
    .ai-testimonial-carousel__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-testimonial-carousel__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size_mobile }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) {
    .ai-testimonial-carousel__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_desktop }}px;
    }
  }

  .ai-testimonial-carousel__carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .ai-testimonial-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    touch-action: pan-y;
  }

  .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    padding: 0 12px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 50%;
      padding: 0 16px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 33.333%;
    }
  }

  .ai-testimonial-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-testimonial-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(125, 69, 198, 0.12);
  }

  .ai-testimonial-carousel__media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 133.33%;
    background-color: #f9f6ff;
    overflow: hidden;
  }

  .ai-testimonial-carousel__media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-carousel__media-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f9f6ff 0%, #e8d9f7 100%);
  }

  .ai-testimonial-carousel__media-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-testimonial-carousel__content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-testimonial-carousel__benefit-pill-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.pill_background }};
    color: {{ block.settings.pill_text_color }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
  }

  .ai-testimonial-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-testimonial-carousel__star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-carousel__name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.name_color }};
    margin: 0 0 12px 0;
  }

  .ai-testimonial-carousel__quote-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.7;
    color: {{ block.settings.quote_color }};
    margin: 0;
  }

  .ai-testimonial-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }} {
    background: none;
    border: 2px solid {{ block.settings.arrow_color }};
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ block.settings.arrow_color }};
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    border-color: {{ block.settings.arrow_hover_background }};
    color: #ffffff;
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }}:disabled:hover {
    background: none;
    border-color: {{ block.settings.arrow_color }};
    color: {{ block.settings.arrow_color }};
  }

  .ai-testimonial-carousel__arrow-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
  }

  .ai-testimonial-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-testimonial-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-testimonial-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-testimonial-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #6b5a85;
    font-size: 14px;
  }
{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }}
  class="ai-testimonial-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonial-carousel__container-{{ ai_gen_id }}">
    <div class="ai-testimonial-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-testimonial-carousel__heading-{{ ai_gen_id }}">
          {{ block.settings.heading | replace: '. ', '.<br>' }}
        </h2>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <p class="ai-testimonial-carousel__subtext-{{ ai_gen_id }}">
          {{ block.settings.subtext }}
        </p>
      {% endif %}
    </div>

    {% assign has_testimonials = false %}
    {% for i in (1..6) %}
      {% assign name_key = 'testimonial_' | append: i | append: '_name' %}
      {% if block.settings[name_key] != blank %}
        {% assign has_testimonials = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_testimonials %}
      <div class="ai-testimonial-carousel__carousel-wrapper-{{ ai_gen_id }}">
        <div class="ai-testimonial-carousel__track-{{ ai_gen_id }}" data-track>
          {% for i in (1..6) %}
            {% liquid
              assign name_key = 'testimonial_' | append: i | append: '_name'
              assign quote_key = 'testimonial_' | append: i | append: '_quote'
              assign benefit_key = 'testimonial_' | append: i | append: '_benefit'
              assign image_key = 'testimonial_' | append: i | append: '_image'

              assign name = block.settings[name_key]
              assign quote = block.settings[quote_key]
              assign benefit = block.settings[benefit_key]
              assign image = block.settings[image_key]
            %}

            {% if name != blank %}
              <div class="ai-testimonial-carousel__slide-{{ ai_gen_id }}">
                <div class="ai-testimonial-carousel__card-{{ ai_gen_id }}">
                  <div class="ai-testimonial-carousel__media-wrapper-{{ ai_gen_id }}">
                    {% if image %}
                      <img
                        src="{{ image | image_url: width: 600 }}"
                        alt="{{ name | escape }}"
                        class="ai-testimonial-carousel__media-{{ ai_gen_id }}"
                        loading="lazy"
                        width="600"
                        height="800"
                      >
                    {% else %}
                      <div class="ai-testimonial-carousel__media-placeholder-{{ ai_gen_id }}">
                        {{ 'image' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>

                  <div class="ai-testimonial-carousel__content-{{ ai_gen_id }}">
                    {% if benefit != blank %}
                      <span class="ai-testimonial-carousel__benefit-pill-{{ ai_gen_id }}">
                        {{ benefit }}
                      </span>
                    {% endif %}

                    <div class="ai-testimonial-carousel__stars-{{ ai_gen_id }}">
                      {% for star in (1..5) %}
                        <svg
                          class="ai-testimonial-carousel__star-{{ ai_gen_id }}"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                        </svg>
                      {% endfor %}
                    </div>

                    <h3 class="ai-testimonial-carousel__name-{{ ai_gen_id }}">
                      {{ name }}
                    </h3>

                    {% if quote != blank %}
                      <p class="ai-testimonial-carousel__quote-{{ ai_gen_id }}">
                        "{{ quote }}"
                      </p>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-testimonial-carousel__controls-{{ ai_gen_id }}">
        <button
          class="ai-testimonial-carousel__arrow-{{ ai_gen_id }}"
          data-prev
          aria-label="Previous testimonial"
        >
          <svg
            class="ai-testimonial-carousel__arrow-icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-testimonial-carousel__dots-{{ ai_gen_id }}" data-dots></div>

        <button
          class="ai-testimonial-carousel__arrow-{{ ai_gen_id }}"
          data-next
          aria-label="Next testimonial"
        >
          <svg
            class="ai-testimonial-carousel__arrow-icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-testimonial-carousel__empty-state-{{ ai_gen_id }}">
        Add testimonials in the block settings to display customer reviews
      </div>
    {% endif %}
  </div>
</testimonial-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.startX = 0;
        this.currentX = 0;
        this.isDragging = false;
        this.threshold = 50;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');

        if (!this.track) return;

        this.slides = Array.from(this.track.children);
        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) return;

        this.createDots();
        this.updateCarousel();
        this.setupEventListeners();
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-testimonial-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to testimonial ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.track.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: true });
        this.track.addEventListener('touchmove', (e) => this.handleTouchMove(e), { passive: true });
        this.track.addEventListener('touchend', () => this.handleTouchEnd());

        this.track.addEventListener('mousedown', (e) => this.handleMouseDown(e));
        this.track.addEventListener('mousemove', (e) => this.handleMouseMove(e));
        this.track.addEventListener('mouseup', () => this.handleMouseUp());
        this.track.addEventListener('mouseleave', () => this.handleMouseUp());
      }

      handleTouchStart(e) {
        this.startX = e.touches[0].clientX;
        this.isDragging = true;
      }

      handleTouchMove(e) {
        if (!this.isDragging) return;
        this.currentX = e.touches[0].clientX;
      }

      handleTouchEnd() {
        if (!this.isDragging) return;
        this.isDragging = false;

        const diff = this.startX - this.currentX;

        if (Math.abs(diff) > this.threshold) {
          if (diff > 0) {
            this.next();
          } else {
            this.prev();
          }
        }

        this.startX = 0;
        this.currentX = 0;
      }

      handleMouseDown(e) {
        this.startX = e.clientX;
        this.isDragging = true;
        this.track.style.cursor = 'grabbing';
      }

      handleMouseMove(e) {
        if (!this.isDragging) return;
        this.currentX = e.clientX;
      }

      handleMouseUp() {
        if (!this.isDragging) return;
        this.isDragging = false;
        this.track.style.cursor = 'grab';

        const diff = this.startX - this.currentX;

        if (Math.abs(diff) > this.threshold) {
          if (diff > 0) {
            this.next();
          } else {
            this.prev();
          }
        }

        this.startX = 0;
        this.currentX = 0;
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentIndex < this.totalSlides - 1) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const offset = -this.currentIndex * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.totalSlides - 1;
        }

        if (this.dotsContainer) {
          const dots = this.dotsContainer.querySelectorAll('.ai-testimonial-carousel__dot-{{ ai_gen_id }}');
          dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }
    }

    customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
  })();
</script>

