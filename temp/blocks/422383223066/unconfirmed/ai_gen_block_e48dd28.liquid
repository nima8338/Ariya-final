{% doc %}
  @prompt
    Better approach
    
    Do this instead:
    
    Mobile
    
    Create 3 separate slide images
    
    Slide 1: 2 ingredients
    Slide 2: 2 ingredients
    Slide 3: 2 ingredients
    
    Then you upload each image into the slider.
    
    Desktop
    
    Create 1 single wide desktop image
    
    all 6 ingredients in one clean layout
    one finished graphic
    no relying on the site builder to assemble cards correctly
    Why this is better
    You control the exact look
    No broken image placeholders
    No weird spacing issues
    No condensed layout problems
    Mobile becomes cleaner because each slide only has 2 ingredients
    Desktop stays polished because it’s one intentionally designed section
    Best structure
    Mobile slides
    White background
    Heading at top: Inside Calm Nights
    Short subheading underneath
    Two roomy ingredient cards per slide
    Each card has:
    floating ingredient image
    category pill
    ingredient title
    short description
    Desktop image
    White background
    Same heading/subheading
    6 ingredients arranged in a spacious 3x2 grid
    Keep the floating ingredient look
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredient-slider-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    display: block;
  }

  .ai-ingredient-slider__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-ingredient-slider__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-ingredient-slider__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .ai-ingredient-slider__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-ingredient-slider__desktop-image-{{ ai_gen_id }} {
    display: none;
  }

  .ai-ingredient-slider__desktop-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-ingredient-slider__mobile-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .ai-ingredient-slider__slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
  }

  .ai-ingredient-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
  }

  .ai-ingredient-slider__slide-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-ingredient-slider__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-ingredient-slider__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-ingredient-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-ingredient-slider__placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: 12px;
    padding: 60px 20px;
    text-align: center;
    color: #666;
  }

  @media screen and (min-width: 750px) {
    .ai-ingredient-slider__desktop-image-{{ ai_gen_id }} {
      display: block;
    }

    .ai-ingredient-slider__mobile-slider-{{ ai_gen_id }} {
      display: none;
    }

    .ai-ingredient-slider__header-{{ ai_gen_id }} {
      margin-bottom: 60px;
    }
  }
{% endstyle %}

<ingredient-slider-{{ ai_gen_id }}
  class="ai-ingredient-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-ingredient-slider__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-ingredient-slider__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-ingredient-slider__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-ingredient-slider__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-ingredient-slider__desktop-image-{{ ai_gen_id }}">
      {% if block.settings.desktop_image %}
        <img
          src="{{ block.settings.desktop_image | image_url: width: 1200 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
        >
      {% else %}
        <div class="ai-ingredient-slider__placeholder-{{ ai_gen_id }}">
          <p>Upload your desktop image (all 6 ingredients in one layout)</p>
        </div>
      {% endif %}
    </div>

    <div class="ai-ingredient-slider__mobile-slider-{{ ai_gen_id }}">
      {% assign has_mobile_images = false %}
      {% if block.settings.mobile_slide_1 or block.settings.mobile_slide_2 or block.settings.mobile_slide_3 %}
        {% assign has_mobile_images = true %}
      {% endif %}

      {% if has_mobile_images %}
        <div class="ai-ingredient-slider__slides-{{ ai_gen_id }}">
          {% if block.settings.mobile_slide_1 %}
            <div class="ai-ingredient-slider__slide-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.mobile_slide_1 | image_url: width: 800 }}"
                alt="{{ block.settings.mobile_slide_1.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.mobile_slide_1.width }}"
                height="{{ block.settings.mobile_slide_1.height }}"
              >
            </div>
          {% endif %}

          {% if block.settings.mobile_slide_2 %}
            <div class="ai-ingredient-slider__slide-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.mobile_slide_2 | image_url: width: 800 }}"
                alt="{{ block.settings.mobile_slide_2.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.mobile_slide_2.width }}"
                height="{{ block.settings.mobile_slide_2.height }}"
              >
            </div>
          {% endif %}

          {% if block.settings.mobile_slide_3 %}
            <div class="ai-ingredient-slider__slide-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.mobile_slide_3 | image_url: width: 800 }}"
                alt="{{ block.settings.mobile_slide_3.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.mobile_slide_3.width }}"
                height="{{ block.settings.mobile_slide_3.height }}"
              >
            </div>
          {% endif %}
        </div>

        <div class="ai-ingredient-slider__dots-{{ ai_gen_id }}">
          {% if block.settings.mobile_slide_1 %}
            <button
              class="ai-ingredient-slider__dot-{{ ai_gen_id }} active"
              data-slide="0"
              aria-label="Go to slide 1"
            ></button>
          {% endif %}
          {% if block.settings.mobile_slide_2 %}
            <button
              class="ai-ingredient-slider__dot-{{ ai_gen_id }}"
              data-slide="1"
              aria-label="Go to slide 2"
            ></button>
          {% endif %}
          {% if block.settings.mobile_slide_3 %}
            <button
              class="ai-ingredient-slider__dot-{{ ai_gen_id }}"
              data-slide="2"
              aria-label="Go to slide 3"
            ></button>
          {% endif %}
        </div>
      {% else %}
        <div class="ai-ingredient-slider__placeholder-{{ ai_gen_id }}">
          <p>Upload your mobile slide images (2 ingredients per slide)</p>
        </div>
      {% endif %}
    </div>
  </div>
</ingredient-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class IngredientSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slidesContainer = this.querySelector('.ai-ingredient-slider__slides-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-ingredient-slider__slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-ingredient-slider__dot-{{ ai_gen_id }}');

        if (!this.slidesContainer || this.slides.length === 0) return;

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const slideIndex = parseInt(dot.getAttribute('data-slide'));
            this.goToSlide(slideIndex);
            this.resetAutoplay();
          });
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.slidesContainer.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        this.slidesContainer.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe(touchStartX, touchEndX);
        });
      }

      handleSwipe(startX, endX) {
        const swipeThreshold = 50;
        const diff = startX - endX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
          this.resetAutoplay();
        }
      }

      goToSlide(index) {
        this.currentSlide = index;
        const offset = -100 * index;
        this.slidesContainer.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(this.currentSlide);
      }

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(this.currentSlide);
      }

      startAutoplay() {
        if (this.slides.length <= 1) return;
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, 5000);
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        clearInterval(this.autoplayInterval);
      }
    }

    customElements.define('ingredient-slider-{{ ai_gen_id }}', IngredientSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Ingredient slider",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inside Calm Nights"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Six natural ingredients for better sleep"
    },
    {
      "type": "header",
      "content": "Desktop image"
    },
    {
      "type": "paragraph",
      "content": "Upload one wide image with all 6 ingredients in a clean layout"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "header",
      "content": "Mobile slides"
    },
    {
      "type": "paragraph",
      "content": "Upload 3 separate images, each showing 2 ingredients"
    },
    {
      "type": "image_picker",
      "id": "mobile_slide_1",
      "label": "Slide 1"
    },
    {
      "type": "image_picker",
      "id": "mobile_slide_2",
      "label": "Slide 2"
    },
    {
      "type": "image_picker",
      "id": "mobile_slide_3",
      "label": "Slide 3"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#3c0e66"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "libre_baskerville_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Ingredient slider"
    }
  ]
}
{% endschema %}