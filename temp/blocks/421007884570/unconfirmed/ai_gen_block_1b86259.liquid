{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-expect-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_side }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-expect-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-expect-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_bottom_spacing }}px;
  }

  .ai-expect-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.1;
    white-space: nowrap;
  }

  .ai-expect-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.body_text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-expect-steps-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.step_spacing_mobile }}px;
  }

  .ai-expect-step-{{ ai_gen_id }} {
    display: flex;
    gap: 0;
    align-items: stretch;
    background-color: {{ block.settings.description_bg_color }};
    border-radius: {{ block.settings.step_border_radius }}px;
    overflow: hidden;
  }

  .ai-expect-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    flex-shrink: 0;
    width: {{ block.settings.image_width_mobile }}px;
    display: flex;
    flex-direction: column;
  }

  .ai-expect-image-container-{{ ai_gen_id }} {
    flex-grow: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px {{ block.settings.image_border_radius }}px 0 0;
  }

  .ai-expect-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-expect-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-expect-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-expect-phase-label-{{ ai_gen_id }} {
    background-color: {{ block.settings.accent_color }};
    padding: {{ block.settings.label_padding }}px;
    text-align: center;
  }

  .ai-expect-phase-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.phase_title_size }}px;
    font-weight: {{ block.settings.phase_title_weight }};
    color: #ffffff;
    margin: 0 0 2px;
    line-height: 1.2;
  }

  .ai-expect-phase-time-{{ ai_gen_id }} {
    font-size: {{ block.settings.timeframe_size }}px;
    color: #ffffff;
    margin: 0;
    opacity: 0.9;
    line-height: 1.2;
  }

  .ai-expect-content-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: {{ block.settings.description_padding }}px;
    display: flex;
    align-items: center;
  }

  .ai-expect-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.body_text_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .ai-expect-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-expect-steps-{{ ai_gen_id }} {
      flex-direction: row;
      gap: {{ block.settings.step_spacing_desktop }}px;
    }

    .ai-expect-step-{{ ai_gen_id }} {
      flex: 1;
      flex-direction: column;
      background-color: transparent;
      border-radius: 0;
    }

    .ai-expect-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      margin-bottom: {{ block.settings.image_text_spacing }}px;
    }

    .ai-expect-image-container-{{ ai_gen_id }} {
      border-radius: {{ block.settings.image_border_radius }}px {{ block.settings.image_border_radius }}px 0 0;
    }

    .ai-expect-content-{{ ai_gen_id }} {
      padding: 0;
      background-color: transparent;
    }

    .ai-expect-description-{{ ai_gen_id }} {
      text-align: center;
    }
  }
{% endstyle %}

<what-to-expect-{{ ai_gen_id }}
  class="ai-expect-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-expect-container-{{ ai_gen_id }}">
    <div class="ai-expect-header-{{ ai_gen_id }}">
      <h2 class="ai-expect-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% if block.settings.subtext_line_1 != blank or block.settings.subtext_line_2 != blank %}
        <p class="ai-expect-subtext-{{ ai_gen_id }}">
          {{ block.settings.subtext_line_1 }}<br>
          {{ block.settings.subtext_line_2 }}
        </p>
      {% endif %}
    </div>

    <div class="ai-expect-steps-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'step_' | append: i | append: '_image'
          assign phase_title_key = 'step_' | append: i | append: '_phase_title'
          assign timeframe_key = 'step_' | append: i | append: '_timeframe'
          assign description_key = 'step_' | append: i | append: '_description'

          assign step_image = block.settings[image_key]
          assign phase_title = block.settings[phase_title_key]
          assign timeframe = block.settings[timeframe_key]
          assign description = block.settings[description_key]
        %}

        <div class="ai-expect-step-{{ ai_gen_id }}">
          <div class="ai-expect-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-expect-image-container-{{ ai_gen_id }}">
              {% if step_image %}
                <img
                  src="{{ step_image | image_url: width: 600 }}"
                  alt="{{ phase_title }}"
                  class="ai-expect-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-expect-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-expect-phase-label-{{ ai_gen_id }}">
              <div class="ai-expect-phase-title-{{ ai_gen_id }}">{{ phase_title }}</div>
              <div class="ai-expect-phase-time-{{ ai_gen_id }}">{{ timeframe }}</div>
            </div>
          </div>

          <div class="ai-expect-content-{{ ai_gen_id }}">
            <p class="ai-expect-description-{{ ai_gen_id }}">{{ description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</what-to-expect-{{ ai_gen_id }}>

<script>
  (function() {
    class WhatToExpect{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('what-to-expect-{{ ai_gen_id }}', WhatToExpect{{ ai_gen_id }});
  })();
</script>

