{% doc %}
  @prompt
    Create a new responsive timeline section for the Calm Nights product page.
    
    Place the section directly after “Why Calm Nights Feels Different” and before “Inside Calm Nights.”
    
    Section heading
    
    What to Expect With Consistent Use
    
    Add this short description underneath:
    
    Calm Nights supports your body’s natural sleep process. Here’s what consistent nightly use may feel like.
    
    Timeline
    
    Create a clean three-step timeline using these stages:
    
    Your First Few Nights
    A calmer wind-down and an easier transition into sleep.
    
    After 1–2 Weeks
    Your nighttime routine may begin feeling more consistent and restful.
    
    Around 30 Days
    More consistent nights may support clearer, more refreshed mornings.
    
    Disclaimer
    
    Add this small text underneath the timeline:
    
    Everyone responds differently. For best results, take two capsules consistently 30–60 minutes before bed.
    
    Design requirements
    Use a clean white background.
    Use Ariya purple #7D45C6 for the timeline line, step markers, and highlighted text.
    Use black for the main body text.
    Keep the design minimal, premium, and easy to scan.
    Display the timeline horizontally on desktop.
    Display the timeline vertically on mobile.
    Connect each stage with a thin purple line.
    Use simple numbered circles or small moon-inspired markers for each stage.
    Keep the descriptions short and readable.
    Do not use exaggerated medical claims or guarantee that results will happen within a specific timeframe.
    Use wording such as “may,” “can support,” and “with consistent use.”
    Keep the section compact and avoid excessive white space.
    Customization settings
    
    Give me editable settings for:
    
    Section heading
    Introductory description
    Each timeline title
    Each timeline description
    Disclaimer text
    Heading size on desktop and mobile
    Body-text size on desktop and mobile
    Timeline marker size
    Timeline line thickness
    Text alignment
    Background color
    Accent color
    Top padding
    Bottom padding
    Side padding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_side }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_side }}px;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-timeline-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-timeline-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.accent_color }};
    margin: 0 0 16px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size_desktop }}px;
    color: #000000;
    margin: 0;
    line-height: 1.6;
  }

  .ai-timeline-stages-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
    margin-bottom: 40px;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.marker_size | divided_by: 2 }}px;
    left: calc({{ block.settings.marker_size | divided_by: 2 }}px + 5%);
    right: calc({{ block.settings.marker_size | divided_by: 2 }}px + 5%);
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.accent_color }};
    z-index: 1;
  }

  .ai-timeline-stage-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    padding: 0 10px;
  }

  .ai-timeline-marker-{{ ai_gen_id }} {
    width: {{ block.settings.marker_size }}px;
    height: {{ block.settings.marker_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.accent_color }};
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: {{ block.settings.marker_size | divided_by: 2 }}px;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .ai-timeline-stage-content-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-timeline-stage-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size_desktop }}px;
    font-weight: 600;
    color: {{ block.settings.accent_color }};
    margin: 0 0 12px 0;
  }

  .ai-timeline-stage-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size_desktop }}px;
    color: #000000;
    margin: 0;
    line-height: 1.5;
  }

  .ai-timeline-disclaimer-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.body_text_size_desktop | times: 0.85 | round }}px;
    color: #666666;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-timeline-description-{{ ai_gen_id }},
    .ai-timeline-stage-title-{{ ai_gen_id }},
    .ai-timeline-stage-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_text_size_mobile }}px;
    }

    .ai-timeline-disclaimer-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_text_size_mobile | times: 0.85 | round }}px;
    }

    .ai-timeline-stages-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-timeline-line-{{ ai_gen_id }} {
      top: {{ block.settings.marker_size | divided_by: 2 }}px;
      left: {{ block.settings.marker_size | divided_by: 2 }}px;
      right: auto;
      width: {{ block.settings.line_thickness }}px;
      height: calc(100% - {{ block.settings.marker_size }}px);
    }

    .ai-timeline-stage-{{ ai_gen_id }} {
      flex-direction: row;
      align-items: flex-start;
      padding: 0 0 30px 0;
    }

    .ai-timeline-stage-{{ ai_gen_id }}:last-child {
      padding-bottom: 0;
    }

    .ai-timeline-marker-{{ ai_gen_id }} {
      margin-bottom: 0;
      margin-right: 20px;
      flex-shrink: 0;
    }

    .ai-timeline-stage-content-{{ ai_gen_id }} {
      text-align: left;
      flex: 1;
    }
  }
{% endstyle %}

<timeline-block-{{ ai_gen_id }}
  class="ai-timeline-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-timeline-content-{{ ai_gen_id }}">
    <div class="ai-timeline-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-timeline-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p class="ai-timeline-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}
    </div>

    <div class="ai-timeline-stages-{{ ai_gen_id }}">
      <div class="ai-timeline-line-{{ ai_gen_id }}"></div>

      <div class="ai-timeline-stage-{{ ai_gen_id }}">
        <div class="ai-timeline-marker-{{ ai_gen_id }}">1</div>
        <div class="ai-timeline-stage-content-{{ ai_gen_id }}">
          {% if block.settings.stage_1_title != blank %}
            <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">{{ block.settings.stage_1_title }}</h3>
          {% endif %}
          {% if block.settings.stage_1_description != blank %}
            <p class="ai-timeline-stage-description-{{ ai_gen_id }}">{{ block.settings.stage_1_description }}</p>
          {% endif %}
        </div>
      </div>

      <div class="ai-timeline-stage-{{ ai_gen_id }}">
        <div class="ai-timeline-marker-{{ ai_gen_id }}">2</div>
        <div class="ai-timeline-stage-content-{{ ai_gen_id }}">
          {% if block.settings.stage_2_title != blank %}
            <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">{{ block.settings.stage_2_title }}</h3>
          {% endif %}
          {% if block.settings.stage_2_description != blank %}
            <p class="ai-timeline-stage-description-{{ ai_gen_id }}">{{ block.settings.stage_2_description }}</p>
          {% endif %}
        </div>
      </div>

      <div class="ai-timeline-stage-{{ ai_gen_id }}">
        <div class="ai-timeline-marker-{{ ai_gen_id }}">3</div>
        <div class="ai-timeline-stage-content-{{ ai_gen_id }}">
          {% if block.settings.stage_3_title != blank %}
            <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">{{ block.settings.stage_3_title }}</h3>
          {% endif %}
          {% if block.settings.stage_3_description != blank %}
            <p class="ai-timeline-stage-description-{{ ai_gen_id }}">{{ block.settings.stage_3_description }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    {% if block.settings.disclaimer != blank %}
      <p class="ai-timeline-disclaimer-{{ ai_gen_id }}">{{ block.settings.disclaimer }}</p>
    {% endif %}
  </div>
</timeline-block-{{ ai_gen_id }}>

<script>
  (function() {
    class TimelineBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('timeline-block-{{ ai_gen_id }}', TimelineBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Timeline",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What to Expect With Consistent Use"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Calm Nights supports your body's natural sleep process. Here's what consistent nightly use may feel like."
    },
    {
      "type": "header",
      "content": "Stage 1"
    },
    {
      "type": "text",
      "id": "stage_1_title",
      "label": "Title",
      "default": "Your First Few Nights"
    },
    {
      "type": "textarea",
      "id": "stage_1_description",
      "label": "Description",
      "default": "A calmer wind-down and an easier transition into sleep."
    },
    {
      "type": "header",
      "content": "Stage 2"
    },
    {
      "type": "text",
      "id": "stage_2_title",
      "label": "Title",
      "default": "After 1–2 Weeks"
    },
    {
      "type": "textarea",
      "id": "stage_2_description",
      "label": "Description",
      "default": "Your nighttime routine may begin feeling more consistent and restful."
    },
    {
      "type": "header",
      "content": "Stage 3"
    },
    {
      "type": "text",
      "id": "stage_3_title",
      "label": "Title",
      "default": "Around 30 Days"
    },
    {
      "type": "textarea",
      "id": "stage_3_description",
      "label": "Description",
      "default": "More consistent nights may support clearer, more refreshed mornings."
    },
    {
      "type": "header",
      "content": "Disclaimer"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "Everyone responds differently. For best results, take two capsules consistently 30–60 minutes before bed."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
