{% doc %}
  @prompt
    give me an option to insert an image and when you click the image it takes you to text messages to text this number, (720) 590-7295
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sms-image-link-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-sms-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-sms-image-wrapper-{{ ai_gen_id }}:hover {
    transform: scale(1.02);
  }

  .ai-sms-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-sms-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
  }

  .ai-sms-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-sms-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-sms-image-link-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div
  class="ai-sms-image-link-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <a
    href="sms:{{ block.settings.phone_number }}"
    class="ai-sms-image-wrapper-{{ ai_gen_id }}"
    aria-label="Send text message to {{ block.settings.phone_number }}"
  >
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="ai-sms-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-sms-empty-state-{{ ai_gen_id }}">
          Add an image to link to text messages
        </div>
      </div>
    {% endif %}
  </a>
</div>

{% schema %}
{
  "name": "SMS image link",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "SMS settings"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "(720) 590-7295"
    }
  ],
  "presets": [
    {
      "name": "SMS image link"
    }
  ]
}
{% endschema %}
