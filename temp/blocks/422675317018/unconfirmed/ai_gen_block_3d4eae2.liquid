{% doc %}
  @prompt
    Create a brand-new Shopify testimonial video carousel from scratch.
    
    Keep it simple and mobile-first.
    
    Section title
    
    Real People.
    Real Results.
    
    Supporting text:
    Hear directly from people who have made Calm Nights part of their nightly routine.
    
    Most important functionality
    Do not autoplay
    Do not continuously scroll
    Show one testimonial centered at a time
    On mobile, the active testimonial must always be perfectly centered
    Nothing from the active card should ever be cut off
    The carousel must not drift farther left or right after multiple clicks
    Navigation
    
    Add:
    
    left arrow
    right arrow
    5 pagination dots
    
    Each arrow click should move exactly one testimonial.
    
    The carousel must keep track of the current testimonial correctly.
    
    If I press:
    
    right once → go to testimonial 2
    right again → testimonial 3
    left once → back to testimonial 2
    left again → back to testimonial 1
    
    The first testimonial must always be reachable again.
    
    Do not allow delayed movement, skipped slides, double movement, or needing to click twice.
    
    Mobile alignment
    
    This is very important:
    
    Every testimonial card must use the same width
    Every slide must be centered inside the mobile viewport
    After every arrow click or swipe, snap the selected card back to the exact center
    Do not calculate movement by repeatedly adding pixel offsets
    Use a proper slide index so the carousel cannot drift out of alignment
    Keep enough side padding so no video, text, badge, or quote is cut off
    Swipe
    
    Allow normal swipe left/right on mobile.
    
    After the swipe ends, snap to exactly one centered testimonial.
    
    Testimonial cards
    
    Use 5 testimonials.
    
    Each card includes:
    
    real Shopify uploaded video
    optional poster image
    benefit badge
    star rating
    customer name
    testimonial quote
    IMPORTANT ABOUT QUOTES
    
    The testimonial quotes I enter must be displayed exactly as written.
    
    Do not rewrite them.
    Do not shorten them.
    Do not fix grammar.
    Do not paraphrase them.
    Do not generate replacement quotes.
    
    Treat all customer quote fields as locked user-entered text.
    
    Video behavior
    
    Videos must use a real HTML video element.
    
    When pressed:
    
    play/open the selected video
    keep the user on the product page
    add a visible X close button
    Design
    
    Keep the existing Ariya visual style:
    
    white testimonial cards
    vertical video
    rounded corners
    subtle shadow
    purple accent color #7D45C6
    gold stars
    dark text
    
    Keep the layout clean and simple.
    
    Final priority
    
    Prioritize correct centering and reliable navigation over fancy animation.
    
    The carousel should behave like a normal manual slider: one centered card, one click = one slide, and left/right always works correctly., make the section fits into the block 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 24px;
    padding: 0 20px;
  }

  .ai-testimonial-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-testimonial-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-testimonial-carousel__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-testimonial-carousel__viewport-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-testimonial-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease-out;
  }

  .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 100%;
    padding: 0 16px;
  }

  .ai-testimonial-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    padding: 20px;
    max-width: 360px;
    margin: 0 auto;
  }

  .ai-testimonial-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    margin-bottom: 16px;
    background-color: #000;
  }

  .ai-testimonial-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-carousel__video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-carousel__video-placeholder-{{ ai_gen_id }} svg {
    width: 48px;
    height: 48px;
    opacity: 0.3;
  }

  .ai-testimonial-carousel__play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    background-color: rgba(255, 255, 255, 0.95);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .ai-testimonial-carousel__play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-testimonial-carousel__play-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    margin-left: 2px;
  }

  .ai-testimonial-carousel__badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 5px 10px;
    border-radius: 16px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .ai-testimonial-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 3px;
    margin-bottom: 10px;
  }

  .ai-testimonial-carousel__star-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-carousel__name-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 6px;
  }

  .ai-testimonial-carousel__quote-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
    opacity: 0.85;
  }

  .ai-testimonial-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
    padding: 0 20px;
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.arrow_background }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonial-carousel__arrow-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
    fill: {{ block.settings.arrow_color }};
  }

  .ai-testimonial-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
  }

  .ai-testimonial-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    opacity: 0.3;
    transition: opacity 0.2s ease;
  }

  .ai-testimonial-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-testimonial-carousel__modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-carousel__modal-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-testimonial-carousel__modal-content-{{ ai_gen_id }} {
    position: relative;
    width: 90%;
    max-width: 500px;
    aspect-ratio: 9 / 16;
  }

  .ai-testimonial-carousel__modal-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-testimonial-carousel__close-button-{{ ai_gen_id }} {
    position: absolute;
    top: -50px;
    right: 0;
    width: 40px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .ai-testimonial-carousel__close-button-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .ai-testimonial-carousel__close-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: #fff;
  }

  @media screen and (min-width: 750px) {
    .ai-testimonial-carousel__header-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }

    .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
      width: 50%;
    }

    .ai-testimonial-carousel__card-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-testimonial-carousel__controls-{{ ai_gen_id }} {
      margin-top: 32px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-testimonial-carousel-{{ ai_gen_id }} {
      padding: 40px 0;
    }

    .ai-testimonial-carousel__header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
      width: 33.333%;
    }

    .ai-testimonial-carousel__container-{{ ai_gen_id }} {
      max-width: 1200px;
      margin: 0 auto;
    }
  }
{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }} class="ai-testimonial-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-carousel__header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-testimonial-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    {% if block.settings.subtitle != blank %}
      <p class="ai-testimonial-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="ai-testimonial-carousel__container-{{ ai_gen_id }}">
    <div class="ai-testimonial-carousel__viewport-{{ ai_gen_id }}">
      <div class="ai-testimonial-carousel__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..5) %}
          {% liquid
            assign video_key = 'testimonial_' | append: i | append: '_video'
            assign poster_key = 'testimonial_' | append: i | append: '_poster'
            assign badge_key = 'testimonial_' | append: i | append: '_badge'
            assign name_key = 'testimonial_' | append: i | append: '_name'
            assign quote_key = 'testimonial_' | append: i | append: '_quote'

            assign video = block.settings[video_key]
            assign poster = block.settings[poster_key]
            assign badge = block.settings[badge_key]
            assign name = block.settings[name_key]
            assign quote = block.settings[quote_key]
          %}

          <div class="ai-testimonial-carousel__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            <div class="ai-testimonial-carousel__card-{{ ai_gen_id }}">
              <div class="ai-testimonial-carousel__video-wrapper-{{ ai_gen_id }}">
                {% if video != blank %}
                  <video
                    class="ai-testimonial-carousel__video-{{ ai_gen_id }}"
                    {% if poster != blank %}
                      poster="{{ poster | image_url: width: 800 }}"
                    {% endif %}
                    preload="metadata"
                    playsinline
                    data-video-index="{{ i }}"
                  >
                    {% for source in video.sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>
                  <button
                    class="ai-testimonial-carousel__play-button-{{ ai_gen_id }}"
                    aria-label="Play video"
                    data-play-button="{{ i }}"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </button>
                {% else %}
                  <div class="ai-testimonial-carousel__video-placeholder-{{ ai_gen_id }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </div>
                {% endif %}
              </div>

              {% if badge != blank %}
                <div class="ai-testimonial-carousel__badge-{{ ai_gen_id }}">{{ badge }}</div>
              {% endif %}

              <div class="ai-testimonial-carousel__stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  <svg class="ai-testimonial-carousel__star-{{ ai_gen_id }}" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              {% if name != blank %}
                <p class="ai-testimonial-carousel__name-{{ ai_gen_id }}">{{ name }}</p>
              {% endif %}

              {% if quote != blank %}
                <p class="ai-testimonial-carousel__quote-{{ ai_gen_id }}">{{ quote }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-testimonial-carousel__controls-{{ ai_gen_id }}">
      <button
        class="ai-testimonial-carousel__arrow-{{ ai_gen_id }}"
        aria-label="Previous testimonial"
        data-prev
      >
        <svg viewBox="0 0 24 24">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <div class="ai-testimonial-carousel__dots-{{ ai_gen_id }}" data-dots>
        {% for i in (1..5) %}
          <button
            class="ai-testimonial-carousel__dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
            aria-label="Go to testimonial {{ i }}"
            data-dot="{{ i }}"
          ></button>
        {% endfor %}
      </div>

      <button
        class="ai-testimonial-carousel__arrow-{{ ai_gen_id }}"
        aria-label="Next testimonial"
        data-next
      >
        <svg viewBox="0 0 24 24">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="ai-testimonial-carousel__modal-{{ ai_gen_id }}" data-modal>
    <div class="ai-testimonial-carousel__modal-content-{{ ai_gen_id }}">
      <button
        class="ai-testimonial-carousel__close-button-{{ ai_gen_id }}"
        aria-label="Close video"
        data-close
      >
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <video
        class="ai-testimonial-carousel__modal-video-{{ ai_gen_id }}"
        controls
        playsinline
        data-modal-video
      ></video>
    </div>
  </div>
</testimonial-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.totalSlides = 5;
        this.touchStartX = 0;
        this.touchEndX = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dots = this.querySelectorAll('[data-dot]');
        this.playButtons = this.querySelectorAll('[data-play-button]');
        this.modal = this.querySelector('[data-modal]');
        this.modalVideo = this.querySelector('[data-modal-video]');
        this.closeButton = this.querySelector('[data-close]');
        this.videos = this.querySelectorAll('[data-video-index]');

        this.setupEventListeners();
        this.updateCarousel();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPrevious());
        this.nextButton.addEventListener('click', () => this.goToNext());

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.playButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            const index = parseInt(button.getAttribute('data-play-button'));
            this.openVideo(index);
          });
        });

        this.closeButton.addEventListener('click', () => this.closeVideo());

        this.modal.addEventListener('click', (e) => {
          if (e.target === this.modal) {
            this.closeVideo();
          }
        });

        this.track.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
        });

        this.track.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
        });
      }

      handleSwipe() {
        const swipeThreshold = 50;
        const diff = this.touchStartX - this.touchEndX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.goToNext();
          } else {
            this.goToPrevious();
          }
        }
      }

      goToPrevious() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      goToNext() {
        if (this.currentIndex < this.totalSlides - 1) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const slideWidth = this.track.querySelector('[data-slide]').offsetWidth;
        const offset = -this.currentIndex * slideWidth;
        this.track.style.transform = `translateX(${offset}px)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex === this.totalSlides - 1;
      }

      openVideo(index) {
        const video = this.videos[index - 1];
        if (!video) return;

        const sources = video.querySelectorAll('source');
        this.modalVideo.innerHTML = '';

        sources.forEach((source) => {
          const newSource = document.createElement('source');
          newSource.src = source.src;
          newSource.type = source.type;
          this.modalVideo.appendChild(newSource);
        });

        this.modalVideo.load();
        this.modal.classList.add('active');
        this.modalVideo.play();
        document.body.style.overflow = 'hidden';
      }

      closeVideo() {
        this.modalVideo.pause();
        this.modalVideo.currentTime = 0;
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
  })();
</script>

